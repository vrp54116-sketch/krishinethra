# ==============================================================================
# KrishiNethra Environment Configuration Template (.env.example)
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Google Gemini API Key (Server-side ONLY — accessed exclusively in /api/gemini route handlers)
# Real key is kept strictly in server env / Vercel project environment variables.
# DO NOT prefix with NEXT_PUBLIC_ or expose in client bundles.
GEMINI_API_KEY=your_gemini_api_key_here

# Open Government Data (data.gov.in) API key for live Indian Mandi agricultural prices (optional)
DATA_GOV_IN_API_KEY=your_datagov_api_key_here

# Mandi commodity resource UUID
COMMODITY_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ESP8266 / ESP32 Edge Node MQTT broker WebSocket URL (optional override)
# Default failover: wss://broker.emqx.io:8084/mqtt then wss://broker.hivemq.com:8884/mqtt
NEXT_PUBLIC_MQTT_BROKER_URL=

# Default farm token for MQTT topics krishinethra/{token}/up and krishinethra/{token}/cmd
NEXT_PUBLIC_MQTT_TOKEN=patelfarm01
